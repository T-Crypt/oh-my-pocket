{
    "compilerOptions": {
        "target": "ES2024",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "types": [],
        "allowJs": true,
        "checkJs": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["web/**/*.js"]
}
